{
  "name": "snrdlr",
  "version": "0.1.0",
  "description": "QR-paired peer-to-peer chat (experimental)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "relay": "node scripts/local-relay.mjs",
    "dev:local": "VITE_NOSTR_RELAYS=ws://localhost:7777 VITE_TURN_URL= vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run src worker",
    "e2e": "playwright test",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "cbor-x": "^1.6.6",
    "preact": "^11.0.1",
    "qrcode-generator": "^2.0.4",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
